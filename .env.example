OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Heart of the Swarm

# Local development still uses the production authentication pipeline.
AUTH_MODE=development
DEVELOPMENT_AUTH_TOKEN=replace-with-a-local-token
DEVELOPMENT_AUTH_USER_ID=local-user
# JWT mode: set AUTH_MODE=jwt and configure all fields below.
JWT_VERIFICATION_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=0
MCP_SERVERS={}
# Example: MCP_SERVERS={"weather":"https://weather.example.com/mcp"}
NETWORK_ALLOW_PUBLIC=true
NETWORK_ALLOW_PRIVATE=false
NETWORK_ALLOWED_CIDRS=[]
NETWORK_DENIED_CIDRS=[]
NETWORK_ALLOW_LOOPBACK=false
NETWORK_ALLOW_LINK_LOCAL=false
NETWORK_ALLOW_METADATA=false
HTTP_MAX_REQUEST_BYTES=2000000
MCP_BEARER_CREDENTIALS={}
# Example: MCP_BEARER_CREDENTIALS={"weather":"weather_api_token"}
# The API container keeps LOCAL_SECRETS empty; authenticated MCP discovery runs in workers/runtimes.
# Exact runtime grants. Published version and node IDs are required; absence means deny.
CAPABILITY_POLICIES={}
# Example: CAPABILITY_POLICIES={"agent_version:VERSION_UUID":["web_search"]}
CAPABILITY_APPROVAL_POLICIES={}
# Example: CAPABILITY_APPROVAL_POLICIES={"workflow_node:VERSION_UUID/NODE_ID":["web_search"]}

# Runtime-owned credential resolution. Values stay local and outside specs/artifacts.
RUNTIME_ID=local-runtime
CREDENTIAL_POLICIES={}
# Example: CREDENTIAL_POLICIES={"runtime:local-runtime":["crm_api_token"]}
LOCAL_SECRETS={}

BUILDER_PROVIDER=openai
BUILDER_MODEL=gpt-4.1-mini
DEFAULT_AGENT_PROVIDER=openrouter
DEFAULT_AGENT_MODEL=openai/gpt-4.1-mini
# Empty allows every model returned by configured providers.
ALLOWED_AGENT_MODELS=

DATABASE_URL=postgresql+asyncpg://swarm:change-me-for-local-development@postgres:5432/swarm
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=swarm

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=heart-of-the-swarm

WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=3
AGENT_TIMEOUT_SECONDS=600
WORKFLOW_MAX_STATE_BYTES=5000000

API_LOG_FILE=logs/api.jsonl
WORKER_LOG_FILE=logs/worker.jsonl
LOG_LEVEL=INFO
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
