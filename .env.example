OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Heart of the Swarm

# Local development still uses the production authentication pipeline.
AUTH_MODE=development
DEVELOPMENT_AUTH_TOKEN=replace-with-a-local-token
DEVELOPMENT_AUTH_USER_ID=local-user
# JWT mode: set AUTH_MODE=jwt and configure all fields below.
JWT_VERIFICATION_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=0
MCP_SERVERS={}
# Example: MCP_SERVERS={"weather":"https://weather.example.com/mcp"}
# Exact runtime grants. Published version and node IDs are required; absence means deny.
CAPABILITY_POLICIES={}
# Example: CAPABILITY_POLICIES={"agent_version:VERSION_UUID":["web_search"]}

BUILDER_PROVIDER=openai
BUILDER_MODEL=gpt-4.1-mini
DEFAULT_AGENT_PROVIDER=openrouter
DEFAULT_AGENT_MODEL=openai/gpt-4.1-mini
# Empty allows every model returned by configured providers.
ALLOWED_AGENT_MODELS=

DATABASE_URL=postgresql+asyncpg://swarm:change-me-for-local-development@postgres:5432/swarm
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=swarm

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=heart-of-the-swarm

WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=3

API_LOG_FILE=logs/api.jsonl
WORKER_LOG_FILE=logs/worker.jsonl
LOG_LEVEL=INFO
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
