OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Heart of the Swarm

BUILDER_PROVIDER=openai
BUILDER_MODEL=gpt-4.1-mini
DEFAULT_AGENT_PROVIDER=openrouter
DEFAULT_AGENT_MODEL=openai/gpt-4.1-mini
# Empty allows every model returned by configured providers.
ALLOWED_AGENT_MODELS=

DATABASE_URL=postgresql+asyncpg://swarm:change-me-for-local-development@postgres:5432/swarm
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=swarm

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=heart-of-the-swarm

WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_ATTEMPTS=3

API_LOG_FILE=logs/api.jsonl
WORKER_LOG_FILE=logs/worker.jsonl
LOG_LEVEL=INFO
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
